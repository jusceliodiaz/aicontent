# --- ComfyUI ---
COMFY_URL=http://127.0.0.1:8188
# true = simulate jobs (no GPU needed) to develop the dashboard
COMFY_MOCK=false
# WORKFLOW_PATH=../workflows/character_swap.api.json

# --- Limits ---
MAX_UPLOAD_MB=80
MAX_VIDEO_SECONDS=6
JOB_TIMEOUT_SECONDS=1800

# --- Portfolio / public demo ---
# true = visitors can only pick preset characters and videos (no uploads, no raw prompt)
PUBLIC_MODE=false
# comma-separated invite codes; leave empty to disable auth (local use only!)
ACCESS_CODES=
JOBS_PER_CODE_PER_DAY=5
# your site + local dev
CORS_ORIGINS=http://localhost:5173,https://seusite.com
